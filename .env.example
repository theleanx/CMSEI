# Copy to .env. Never commit .env.
APP_ENV=production
PUBLIC_BASE_URL=https://your-domain.example
DATABASE_URL=postgresql://user:pass@host:5432/db
ADMIN_PASSWORD=change-me-long-random          # reviewer console (/admin)
ANTHROPIC_API_KEY=                              # empty = offline keyword classifier and extractor
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_DAILY_CALL_CAP=200
CLAUDE_MONTHLY_CALL_CAP=3000
# Event layer: leave false until the go-live test is done and a reviewer approves.
PUBLISH_EVENTS=false
LAUNCH_STATUS=preview
CONTACT_URL=mailto:maintainer@your-domain.example
